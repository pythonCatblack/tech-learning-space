---
import fs from 'node:fs';
import path from 'node:path';
import CourseLayout from '../../../../layouts/CourseLayout.astro';
import RawHtml from '../../../../components/RawHtml.astro';
import MediaContent from '../../../../components/MediaContent';
import TableOfContents from '../../../../components/TableOfContents';
import { getCourseBySlug, courses } from '../../../../courses';
import { extractToc } from '../../../../lib/toc';
import { transformMediaEmbeds } from '../../../../lib/media';

export async function getStaticPaths() {
  return courses.flatMap((course) =>
    course.chapters.map((chapter) => ({
      params: { course: course.slug, chapter: chapter.id },
      props: { course, chapter },
    }))
  );
}

const { course, chapter } = Astro.props as {
  course: NonNullable<ReturnType<typeof getCourseBySlug>>;
  chapter: NonNullable<ReturnType<typeof getCourseBySlug>>['chapters'][number];
};
const htmlPath = path.join(course.sourceRoot, chapter.sourceFile);
const rawHtml = fs.readFileSync(htmlPath, 'utf-8');

// Transform media embeds in HTML (extract placeholders for React hydration)
const { transformedHtml, mediaEmbeds } = transformMediaEmbeds(rawHtml);
const hasMediaEmbeds = mediaEmbeds.length > 0;

// Extract TOC from HTML
const tocItems = extractToc(transformedHtml);

// Add IDs to headings in HTML for anchor links
function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/\s+/g, '-') // Replace spaces with hyphens
    .replace(/[^\w一-鿿-]/g, '') // Keep alphanumeric, Chinese chars, and hyphens
    .replace(/--+/g, '-') // Replace multiple hyphens with single
    .replace(/^-+|-+$/g, ''); // Trim hyphens from start/end
}

function extractText(html: string): string {
  return html
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .trim();
}

let processedHtml = transformedHtml;
// Add IDs to h2.section-h2 and h3.section-h3
processedHtml = processedHtml.replace(
  /<(h[23])\s+class="section-h[23]">([\s\S]*?)<\/\1>/gi,
  (match, tag, content) => {
    const text = extractText(content);
    const id = slugify(text);
    return `<${tag} class="section-h${tag === 'h2' ? '2' : '3'}" id="${id}">${content}</${tag}>`;
  }
);

const currentIndex = course.chapters.findIndex((item) => item.id === chapter.id);
const previousChapter = currentIndex > 0 ? course.chapters[currentIndex - 1] : undefined;
const nextChapter =
  currentIndex >= 0 && currentIndex < course.chapters.length - 1
    ? course.chapters[currentIndex + 1]
    : undefined;
---

<CourseLayout course={course} activeChapterId={chapter.id} backHref={`/course/${course.slug}/`}>
  <section class="page-hero">
    <div class="chapter-tag">{course.title}</div>
    <h1>{chapter.title}</h1>
    <p class="page-subtitle">{chapter.summary}</p>
    <div class="hero-meta">
      <span class="hero-meta-item">{chapter.readTime}</span>
      <span class="hero-meta-item">Chapter {chapter.id}</span>
      <span class="hero-meta-item">独立进度同步</span>
    </div>
  </section>

  <div class="chapter-toc-wrapper">
    <TableOfContents client:load items={tocItems} />
  </div>

  {hasMediaEmbeds ? (
    <MediaContent client:load html={processedHtml} mediaEmbeds={mediaEmbeds} />
  ) : (
    <RawHtml html={processedHtml} />
  )}

  <div class="nav-foot">
    {
      previousChapter ? (
        <a class="nav-btn" href={`/course/${course.slug}/chapter/${previousChapter.id}/`}>
          <span class="nav-btn-icon">←</span>
          <div>
            <div class="nav-btn-lbl">Previous</div>
            <div class="nav-btn-ttl">{previousChapter.navLabel}</div>
          </div>
        </a>
      ) : (
        <div />
      )
    }

    {
      nextChapter ? (
        <a class="nav-btn next" href={`/course/${course.slug}/chapter/${nextChapter.id}/`}>
          <span class="nav-btn-icon">→</span>
          <div>
            <div class="nav-btn-lbl">Next</div>
            <div class="nav-btn-ttl">{nextChapter.navLabel}</div>
          </div>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</CourseLayout>
